<?xml version="1.0" encoding="UTF-8"?>
<!--
  Parameters specific to the OpenAI Responses dialect, which exists for exactly
  one thing: a reasoning model's chain of thought surviving a tool call. That
  is why a <thinking> part's signature matters more here than anywhere else --
  it carries the encrypted reasoning item, and a summary without it is prose
  about the thinking rather than the thinking.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cai="https://github.com/wow-look-at-my/common-ai-api/schema/v1"
           targetNamespace="https://github.com/wow-look-at-my/common-ai-api/schema/v1/responses"
           elementFormDefault="qualified"
           attributeFormDefault="qualified">

  <xs:import namespace="https://github.com/wow-look-at-my/common-ai-api/schema/v1"/>

  <xs:attribute name="reasoning-effort" type="xs:string"/>
  <xs:attribute name="temperature" type="xs:decimal"/>
  <xs:attribute name="top-p" type="xs:decimal"/>
  <xs:attribute name="truncation" type="xs:string"/>

  <xs:element name="params" type="cai:paramList"/>

</xs:schema>
